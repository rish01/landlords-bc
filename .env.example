# Copy to .env.local (web) / .env (worker). Never commit secrets.
# Region: systems of record live in AWS ca-central-1.

NODE_ENV=development
APP_URL=http://localhost:3000

# AI is dark until Phase 5. Do not set spacexai/xai in production before the PIPA gate.
AI_PROVIDER=none
# XAI_API_KEY=

DATABASE_URL=postgres://lbc:lbc@localhost:5432/landlords_bc
REDIS_URL=redis://localhost:6379

# Better Auth (PR-05). Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Stripe (PR-10). Prices live in Stripe, never in git. Stripe Tax is off.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email (PR-15)
POSTMARK_TOKEN=

# Uploads (PR-16)
S3_QUARANTINE_BUCKET=
S3_CLEAN_BUCKET=
S3_REGION=ca-central-1
KMS_KEY_ARN=

# Observability (PR-17)
SENTRY_DSN=

# Bot protection (PR-05)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# Local/staging Super Admin seed only. FORBIDDEN in production.
# DEV_SUPERADMIN_EMAIL=
# DEV_SUPERADMIN_PASSWORD=

WORKER_PORT=3001

# Design-system gallery at /internal/ui. On in local/dev. Staging: set 1. Production: omit or 0.
# INTERNAL_UI=1

{
  "name": "@lbc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "seed": "tsx src/seed/run.ts",
    "auth:generate": "npx auth@1.7.5 generate --config src/auth-config.ts --output src/schema/better-auth.ts --yes"
  },
  "dependencies": {
    "better-auth": "1.7.5",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@lbc/config": "workspace:*",
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

{
  "name": "landlords-bc",
  "private": true,
  "description": "Digital home for BC landlords — membership, knowledge, community, and advocacy.",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "eslint . && pnpm --filter @lbc/web lint",
    "lint:web": "pnpm --filter @lbc/web lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "audit": "pnpm audit --audit-level=critical"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "unrs-resolver"]
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "eslint": "^9.36.0",
    "prettier": "^3.6.2",
    "turbo": "^2.11.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.0",
    "vitest": "^3.2.4"
  }
}
